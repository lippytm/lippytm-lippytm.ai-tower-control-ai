{
  "name": "ai-tower-control",
  "version": "1.0.0",
  "description": "AI Control Tower – connects ChatGPT/OpenAI with AllBots.com.ai, Factory.ai, Replit and GitHub Copilot with cybersecurity and automated data management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint src tests"
  },
  "keywords": [
    "ai",
    "control-tower",
    "chatgpt",
    "openai",
    "allbots",
    "factory-ai",
    "replit",
    "github-copilot",
    "cybersecurity"
  ],
  "author": "lippytm",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.1",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "detectOpenHandles": true
  }
}
