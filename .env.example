# AI Control Tower configuration. Never commit real secrets.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=CHANGEME_REPLACE_WITH_32_PLUS_RANDOM_CHARS
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096
AI_REVIEW_PROVIDERS=openai,gemini,claude
ALLBOTS_API_KEY=your_allbots_api_key
ALLBOTS_BASE_URL=https://api.allbots.com.ai
FACTORY_AI_API_KEY=your_factory_ai_api_key
FACTORY_AI_BASE_URL=https://api.factory.ai
REPLIT_API_KEY=your_replit_api_key
REPLIT_BASE_URL=https://replit.com/api/v1
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=lippytm
GITHUB_REPO=lippytm-lippytm.ai-tower-control-ai
PUBLISH_MANIFEST=publishing/manifest.example.json
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CORS_ORIGINS=
TOWER_API_URL=https://your-deployed-tower-url
TOWER_CLIENT_ID=your_client_id
TOWER_CLIENT_SECRET=your_client_secret
