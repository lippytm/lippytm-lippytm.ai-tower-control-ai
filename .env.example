# AI Control Tower – Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Server
PORT=3000
HOST=127.0.0.1
# Set to loopback only when using a reverse proxy on the same host.
TRUST_PROXY=
NODE_ENV=development
LOG_LEVEL=info

# JWT secret for API authentication (generate a long random string, minimum 32 characters)
JWT_SECRET=CHANGEME_REPLACE_WITH_32_PLUS_RANDOM_CHARS

# OpenAI API (separate billing from ChatGPT / ChatGPT Business subscriptions)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Gemini API (not a Gemini consumer subscription)
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude API (not a Claude consumer subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# AllBots.com.ai
ALLBOTS_API_KEY=your_allbots_api_key
ALLBOTS_BASE_URL=https://api.allbots.com.ai

# Factory.ai
FACTORY_AI_API_KEY=your_factory_ai_api_key
FACTORY_AI_BASE_URL=https://api.factory.ai

# Replit
REPLIT_API_KEY=your_replit_api_key
REPLIT_BASE_URL=https://replit.com/api/v1

# GitHub (Copilot / API)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=your_github_owner
GITHUB_REPO=your_github_repo

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# The generic sync worker is a simulation, not real data transfer.
# Production rejects sync dispatch unless explicitly enabled for a disposable pilot.
ENABLE_SYNC_SIMULATION=false

# Opt-in descriptor health-check loop; this does not launch real agent workers.
SWARM_HEALTH_CHECK_ENABLED=false

# CORS – comma-separated list of allowed origins (leave unset to allow all origins)
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# API client authentication (also used by .github/workflows/webhook.yml).
# The webhook workflow's repository secrets must match these server credentials.
TOWER_API_URL=https://your-deployed-tower-url
TOWER_CLIENT_ID=your_client_id
TOWER_CLIENT_SECRET=
# Generate TOWER_CLIENT_SECRET separately from JWT_SECRET (minimum 32 random characters).
