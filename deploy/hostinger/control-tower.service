[Unit]
Description=lippytm.ai Control Tower
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=control-tower
Group=control-tower
WorkingDirectory=/opt/control-tower
EnvironmentFile=/etc/control-tower.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/control-tower/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
